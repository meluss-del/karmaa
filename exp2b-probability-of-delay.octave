% Experiment No. 2 (Part 2): Probability of Delay (Erlang C)
clc;
clear all;
close all;

A = 0.1:0.1:100;
D = 0;
for C = [1, 2, 5, 10, 50, 100]
    a = (A.^C);
    for k = 0:1:C-1
        D = D + ((A.^k) / (factorial(k)));
    end
    B = (A.^C) + ((factorial(C)) .* (1 - (A/C)) .* D);
    Pr = a ./ B;
    loglog(A, Pr);
    hold on;
    grid on;
    axis([0.1 100 0.01 0.1]);
end
xlabel('Traffic Intensity');
ylabel('Probability of delay');
