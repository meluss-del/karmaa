clc;
clear all;
close all;

% Experiment No. 1: Calculation of N and Q (Average and Worst-Case SIR vs N)
i = [1 1 2 1];
j = [1 2 1 3];
N = i.^2 + i.*j + j.^2;
Q = sqrt(3*N);

for n = 2:1:4
    avg_sidb = 10*(log10(0.167./(Q.^-n)));
    worst_sidb = 10*log10(0.5./((Q.^-n + (Q-1).^-n + (Q+1).^-n)));
    plot(N, avg_sidb, N, worst_sidb);
    xlabel('cluster size');
    ylabel('S/I ratio');
    title('Average and worst-case SIR vs N');
    hold on;
    grid on;
    text(8.1, 7, 'n=2');
    text(8.1, 14, 'n=3');
    text(8.1, 21, 'n=4');
    text(12.236, 9.248, 'Average Case');
    text(12.236, 6.8996, 'worst Case');
    text(12.236, 16.733, 'Average Case');
    text(12.236, 14.752, 'worst Case');
    text(12.236, 24.439, 'Average Case');
    text(12.236, 22.364, 'worst Case');
end
